# The nginx image fills ${API_GATEWAY_URL} from the environment at startup.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The API goes to the gateway on the same origin, so the refresh cookie stays first-party and no CORS is needed.
    location /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # recommendation-service may think for a while; the gateway allows 120 s.
        proxy_read_timeout 130s;
    }

    # Build files have content hashes in their names, so they can be cached for long.
    location ~* \.(?:js|css|woff2?|svg|ico|png|jpe?g|webp)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Routes of the single-page app all serve index.html, which must never be cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
